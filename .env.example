# ─────────────────────────────────────────────────────────────
# KYRO — Environment variables
# Copy to .env.local for local dev. In Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview),
# then REDEPLOY (Vite embeds VITE_* vars at build time).
# ─────────────────────────────────────────────────────────────

# Supabase — required for real auth / email OTP.
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "anon" / "publishable" public key (safe for the browser).
# NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Later (V1) ──────────────────────────────────────────────
# Meta Marketing API
# VITE_META_APP_ID=
# VITE_META_GRAPH_API_VERSION=v21.0
# META_APP_SECRET=            # server-only, never VITE_
# Square / Trolley
# SQUARE_ACCESS_TOKEN=
# TROLLEY_API_KEY=
