# ─────────────────────────────────────────────────────────────
# KYRO — Environment variables
#
# Copy to .env.local for local dev. In Vercel, add these under
# Project → Settings → Environment Variables, then REDEPLOY
# (Vite embeds VITE_* vars at build time).
#
# NAMING RULE, no exceptions:
#   VITE_*  is compiled into the browser bundle and is PUBLIC.
#   Everything else is server-only and must never gain a VITE_ prefix.
# A secret in a VITE_ var is a secret published to every visitor.
# ─────────────────────────────────────────────────────────────

# ── Supabase (live) ─────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / publishable key. Safe for the browser.
# NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Needed by the webhook and OAuth endpoints to write rows
# that RLS blocks for end users (orders, attributions, earnings).
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta Marketing API ──────────────────────────────────────
# App: "Kyro" · developers.facebook.com
# Business portfolio: Kevin Aragon™ (488738170269658)
# Status: app created, Marketing API use cases added, business
#         verification submitted 16 Sep 2026.
VITE_META_APP_ID=964272639774131
VITE_META_GRAPH_API_VERSION=v25.0
# Server-only. App Secret from App settings → Basic.
META_APP_SECRET=
# Set once the OAuth endpoint exists; must match the Valid OAuth
# Redirect URI configured on the Meta app.
META_REDIRECT_URI=https://kyro-phi.vercel.app/api/meta/callback

# ── Shopify ─────────────────────────────────────────────────
# App: "Kyro" · Shopify Dev Dashboard (Partner: KYRO)
# Scopes: read_orders, read_fulfillments, read_products
VITE_SHOPIFY_CLIENT_ID=df3d593d79cf8787c3a6d8db517efe38
# Server-only. Does TWO jobs: OAuth token exchange AND webhook HMAC
# verification. Treat it like a password.
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://kyro-phi.vercel.app/api/shopify/callback
SHOPIFY_API_VERSION=2026-07
# Random string used to sign the OAuth `state` parameter so a callback
# can't be forged. Generate with: openssl rand -hex 32
SHOPIFY_OAUTH_STATE_SECRET=

# ── Payments (not yet wired) ────────────────────────────────
# Card for the $2,500 deposit, ACH for recurring commission billing.
# ACH matters: at a 1% take rate card processing exceeds the margin.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=

# ── Creator payouts (not yet wired) ─────────────────────────
# Handles W-9 / W-8BEN collection and 1099-NEC filing.
# TROLLEY_API_KEY=
# TROLLEY_API_SECRET=
