{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/usage",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/stripe/settle",
      "schedule": "0 8 * * *"
    }
  ]
}
